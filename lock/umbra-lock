#!/usr/bin/env bash
# Starts the UMBRA lock screen. Bind it in Hyprland, e.g.
#   hl.bind(mainMod .. " + L", hl.dsp.exec_cmd("~/Documentos/projetos/umbra/lock/umbra-lock"))
# Recovery if it ever hangs: Ctrl+Alt+F3, log in, `pkill quickshell`.
set -euo pipefail
dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
command -v quickshell >/dev/null 2>&1 || { echo "quickshell not found" >&2; exit 127; }
# One lock at a time; a second press does nothing.
if pgrep -f -- "quickshell.*lock\.qml" >/dev/null 2>&1; then exit 0; fi

# Frosted background: a screenshot of the desktop as it is now, taken only
# if grim exists. It stays in XDG_RUNTIME_DIR (tmpfs, per user) with mode
# 0600 and is deleted when the lock exits. Any failure just means no
# screenshot: the lock then shows the black scene with the planet.
shot=""
runtime="${XDG_RUNTIME_DIR:-}"
if [[ -n "$runtime" && -d "$runtime" && -O "$runtime" ]] && command -v grim >/dev/null 2>&1; then
    rm -f -- "$runtime"/umbra-lock-*.png   # left over from a crash
    shot="$runtime/umbra-lock-$$.png"
    if ! (umask 077 && timeout 2 grim -l 1 "$shot") 2>/dev/null; then
        rm -f -- "$shot"
        shot=""
    fi
fi
cleanup() {
    if [[ -n "$shot" ]]; then rm -f -- "$shot"; fi
}
trap cleanup EXIT

export QSG_RENDER_LOOP="${QSG_RENDER_LOOP:-threaded}"
# Not exec: the shell stays to delete the screenshot after Quickshell exits
# (unlock, crash or `pkill quickshell`).
UMBRA_LOCK_BACKGROUND="$shot" quickshell --no-color --path "$dir/../lock.qml"
